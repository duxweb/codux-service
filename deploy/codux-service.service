[Unit]
Description=Codux relay service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=codux
Group=codux
ExecStart=/usr/local/bin/codux-service -addr :8088 -db /opt/codux-service/data/codux-service.sqlite3
Restart=always
RestartSec=3
WorkingDirectory=/opt/codux-service

[Install]
WantedBy=multi-user.target
